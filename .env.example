# Community (closed-circuit social) — off for Store v1.
# Set to true only after report/block exists.
NEXT_PUBLIC_ENABLE_COMMUNITY=false

# Optional. Leave empty to run the local vault without Community/Chat.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dev only: force Pro tier without an unlock code.
# DIGITAL_LEGACY_FORCE_PRO=true

# Pro Cloud mail is sent by deadman-check (MAIL_PROVIDER=auto|off|ses|resend).
# Default with no keys: off (free). Prefer SES for low cost — see docs/CLOUD.md.
